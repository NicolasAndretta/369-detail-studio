# ── Panel de galería (/admin) ────────────────────────────────
# Copiar este archivo como `.env.local` y completar los valores.
# NUNCA commitear `.env.local` (ya está en .gitignore).

# Supabase → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clave con la que entran Nico y el primo al panel.
# Mínimo 16 caracteres. Se guarda también en el hPanel de Hostinger.
ADMIN_PASSWORD=

# Secreto para firmar la sesión (cualquier texto largo al azar, 40+ caracteres).
# Si se cambia, se cierran todas las sesiones abiertas — sirve para echar a
# alguien sin tener que cambiar la clave.
ADMIN_SESSION_SECRET=

# ── SEO ──────────────────────────────────────────────────────
# URL pública del sitio, SIN barra al final.
# Solo hace falta mientras 369detail.com.ar no esté propagado: poner acá la
# URL provisoria de Hostinger para que el canonical y el sitemap apunten a
# una dirección que exista de verdad. Cuando el dominio ande, borrar la línea.
# NEXT_PUBLIC_SITE_URL=https://tu-url-provisoria.hostingersite.com
